{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Synx",
  "scopeName": "source.synx",
  "fileTypes": [
    "snx"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#import"
        },
        {
          "include": "#type-declaration"
        },
        {
          "include": "#impl"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#blocks"
        }
      ]
    },
    "blocks": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.synx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.synx"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.synx",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.synx",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.synx",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.synx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "constant.character.escape.synx",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.synx",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.synx"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.synx"
            }
          },
          "contentName": "source.synx",
          "patterns": [
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.unicode.synx",
          "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.synx",
          "match": "\\\\[ntr0\\\\'\"{}]"
        },
        {
          "name": "invalid.illegal.escape.synx",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.synx",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.synx",
          "match": "\\b0[xX][0-9A-Fa-f_]+L?\\b"
        },
        {
          "name": "constant.numeric.binary.synx",
          "match": "\\b0[bB][01_]+L?\\b"
        },
        {
          "name": "constant.numeric.float.synx",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?f?\\b"
        },
        {
          "name": "constant.numeric.float.synx",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*f?\\b"
        },
        {
          "name": "constant.numeric.integer.synx",
          "match": "\\b[0-9][0-9_]*[Lf]?\\b"
        }
      ]
    },
    "import": {
      "match": "\\b(pub\\s+)?(import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.synx"
        },
        "2": {
          "name": "keyword.control.import.synx"
        },
        "3": {
          "name": "entity.name.namespace.synx"
        }
      }
    },
    "type-declaration": {
      "match": "\\b(struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.$1.synx"
        },
        "2": {
          "name": "entity.name.type.synx"
        }
      }
    },
    "impl": {
      "match": "\\b(impl)\\b",
      "captures": {
        "1": {
          "name": "storage.type.impl.synx"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.synx",
          "match": "\\b(if|else|while|for|in|loop|match|return|break|continue|await)\\b"
        },
        {
          "name": "storage.modifier.synx",
          "match": "\\b(pub|const|extern|unsafe|async|once|dyn)\\b"
        },
        {
          "name": "storage.type.synx",
          "match": "\\b(var|fn)\\b"
        },
        {
          "name": "keyword.operator.cast.synx",
          "match": "\\bas\\b"
        },
        {
          "name": "constant.language.boolean.synx",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.synx",
          "match": "\\bself\\b"
        },
        {
          "name": "storage.type.self.synx",
          "match": "\\bSelf\\b"
        },
        {
          "name": "storage.type.primitive.synx",
          "match": "\\b(bool|byte|short|int|long|uint|ulong|usize|float|double|char|void|str)\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[A-Za-z0-9_<>,&\\s\\[\\]?:+.]*>)?\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.synx"
        }
      }
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.synx",
          "match": "\\b(String|Vec|Option|Result|Box|HashMap|Task|Future|Poll|Waker|Arc|Mutex|Cell)\\b"
        },
        {
          "name": "entity.name.type.synx",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.synx",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.synx",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.synx",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.synx",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.synx",
          "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<|>>)="
        },
        {
          "name": "keyword.operator.assignment.synx",
          "match": "="
        },
        {
          "name": "keyword.operator.question.synx",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.synx",
          "match": "\\+|-|\\*|/|%|&|\\||\\^|~|<<|>>|<|>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.synx",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.synx",
          "match": ","
        },
        {
          "name": "punctuation.accessor.synx",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.synx",
          "match": ":"
        }
      ]
    }
  }
}
