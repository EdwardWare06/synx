/// Build/run argument parsing. Ported from compiler/src/main.cpp, cmd_build.
/// Owned results retain input/output paths; parsing performs no host operations.
import target.Target;

pub struct BuildOptions {
    pub String input;
    pub String output;
    pub bool keep_object;
    pub bool verbose;
    pub Target target;
    pub int linker;
    pub BuildOptions new(Target target) {
        return BuildOptions { input: String.new(), output: String.new(), keep_object: false, verbose: false, target: target, linker: -1 };
    }
}
pub Result<BuildOptions, String> parse(&const Vec<String> args, Target target) {
    var options = BuildOptions.new(target); usize i = 2;
    while (i < args.len()) {
        var argument = args.get(i).unwrap();
        if (*argument == String.from("-o") && i + 1 < args.len()) {
            i += 1; options.output = String.from(args.get(i).unwrap());
        } else if (*argument == String.from("--keep-obj")) { options.keep_object = true; }
        else if (*argument == String.from("--no-regalloc")) { options.target.register_allocation = false; }
        else if (*argument == String.from("--release")) { options.target.checked_arithmetic = false; }
        else if (*argument == String.from("--linker=builtin")) { options.linker = 0; }
        else if (*argument == String.from("--linker=system")) { options.linker = 1; }
        else if (*argument == String.from("-v") || *argument == String.from("--verbose")) { options.verbose = true; }
        else if (argument.starts_with("-")) { return Err("unknown option: {argument}\n"); }
        else { options.input = String.from(argument); }
        i += 1;
    }
    if (options.input.is_empty()) { return Err(String.from("build needs a file argument\n")); }
    return Ok(options);
}
