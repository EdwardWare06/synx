/// Source-to-executable orchestration. Ported from compiler/src/build.cpp.
/// Compilation owns every source, semantic record and IR value until Axon ends.
/// The system linker inherits standard streams; no shell parses path arguments.
import driver_options.BuildOptions;
import driver_paths;
import driver_io;
import compile.Compilation;
import prelude_source;
import axon.Axon;
import objfile.{ObjectFile, write_object};
import std.fs;
import std.mem;
import link.linker;
import link.model;
import link.objects;
import link.standalone;
import driver_fingerprint;
import debug.data;
import debug.cv_types;
import link.macho_sha256;
import link.pe_debug;

pub struct BuildResult {
    pub bool ok;
    pub String executable;
    pub String object;
    pub String source_hash;
    pub BuildResult failed() { return BuildResult { ok: false, executable: String.new(), object: String.new(), source_hash: String.new() }; }
}
pub void report(&const Compilation compilation) {
    driver_io.cstring(2, compilation.diagnostics());
    usize errors = compilation.lowerer.ck.r.sink.errors;
    var suffix = if (errors == 1) { "" } else { "s" };
    driver_io.text(2, "{errors} error{suffix}\n");
}
pub bool prelude_error(&const Compilation compilation) {
    if (!compilation.prelude_sink.has_errors()) { return false; }
    driver_io.text(2, "internal error: the prelude does not check\n");
    driver_io.cstring(2, compilation.prelude_diagnostics()); return true;
}
pub BuildResult program(&const BuildOptions options) {
    var loaded = Compilation.load(options.input, prelude_source.source(), "", 5, true);
    match loaded {
        Err(_) => { driver_io.text(2, "cannot read file: {options.input}\n"); return BuildResult.failed(); },
        Ok(compilation) => {
            if (prelude_error(compilation)) { return BuildResult.failed(); }
            var source_hash = if (options.cache_record) { compilation.source_hash() } else { String.new() };
            var ax = Axon.new(options.target);
            if (compilation.ok) {
                compilation.ok = ax.generate(&compilation.lowerer.ck, &const compilation.trees, &compilation.lowerer.module);
            }
            if (!compilation.ok) { report(compilation); return BuildResult.failed(); }
            if (options.target.debug_info) { ax.obj.debug = data.resolve(ax.obj.debug_raw, compilation.sources); ax.obj.debug.types = mem.replace(&ax.debug_types.types, Vec.new());
                if (options.target.win64_abi() && !cv_types.supported(ax.obj.debug)) { driver_io.text(2, "debug types exceed CodeView record limits; use --no-debug\n"); return BuildResult.failed(); }
                if (options.target.win64_abi()) { for (s in &const compilation.sources) { ax.obj.debug.hashes.push(macho_sha256.digest(s.data(), 0, s.data().len())); } }
            }
            var obj = mem.replace(&ax.obj, ObjectFile.new());
            var executable = driver_paths.output_path(options);
            var object = driver_paths.object_path(executable, options.target);
            var data = write_object(obj, options.target.format());
            match fs.write(object, data) {
                Err(_) => { driver_io.text(2, "cannot write {object}\n"); return BuildResult.failed(); }, Ok(_) => {}
            }
            if (options.verbose) {
                usize functions = compilation.lowerer.module.functions.len(); usize code = obj.text.len();
                var target_name = options.target.name();
                driver_io.text(2, "Dendrite IR: {functions} functions\nAxon code generator: {target_name}, {code} bytes of code\n");
            }
            if (driver_paths.selected_linker(options) == 0 && options.standalone) {
                var path = driver_paths.runtime_host(options.target);
                if (path.is_empty()) { driver_io.text(2, "cannot find the Synx runtime host (set SYNX_RUNTIME_HOST)\n"); return BuildResult.failed(); }
                var host = match fs.read(path) { Ok(value) => value, Err(_) => { driver_io.text(2, "cannot read runtime host: {path}\n"); return BuildResult.failed(); } };
                int os = match options.target.os { Linux => 0, Windows => 1, MacOs => 2 };
                var records = objects.load(data, object, os);
                match records {
                    Err(error) => { var description = model.description(error.code); driver_io.text(2, "built-in linker: {description} {error.symbol}\n"); return BuildResult.failed(); }
                    Ok(inputs) => match standalone.bundle(inputs, host, os, pe_debug.name(executable)) {
                        Err(error) => { var description = model.description(error.code); driver_io.text(2, "built-in linker: {description} {error.symbol} (record {error.record})\n"); return BuildResult.failed(); }
                        Ok(output) => { if (options.verbose) { driver_io.text(2, "link: built-in linker, standalone runtime\n"); }
                            if (!output.pdb.is_empty()) { match linker.publish(pe_debug.path(executable), output.pdb) { Err(_) => { driver_io.text(2, "cannot write PDB for {executable}\n"); return BuildResult.failed(); }, Ok(_) => {} } }
                            match linker.publish(executable, output.exe) { Err(_) => { driver_io.text(2, "cannot write {executable}\n"); return BuildResult.failed(); }, Ok(_) => {} }
                        }
                    }
                }
            } else if (driver_paths.selected_linker(options) == 0) {
                var capsule = driver_paths.runtime_capsule(options.target);
                if (capsule.is_empty()) { driver_io.text(2, "cannot find the Synx runtime capsule (set SYNX_RUNTIME_SHARED)\n"); return BuildResult.failed(); }
                int os = match options.target.os { Linux => 0, Windows => 1, MacOs => 2 };
                if (options.verbose) { driver_io.text(2, "link: built-in linker\n"); }
                match linker.file(object, executable, capsule, os) {
                    Err(error) => { var description = model.description(error.code); driver_io.text(2, "built-in linker: {description} {error.symbol} (input {error.input}, record {error.record})\n"); return BuildResult.failed(); }, Ok(_) => {}
                }
            } else {
            var runtime = driver_paths.runtime_library(options.target);
            if (runtime.is_empty()) { driver_io.text(2, "cannot find the Synx runtime library (set SYNX_RUNTIME_LIB)\n"); return BuildResult.failed(); }
            if (options.verbose) { var text = driver_paths.link_text(options.target, object, runtime, executable); driver_io.text(2, "link: {text}\n"); }
            var command = driver_paths.link_command(options.target, object, runtime, executable);
            match command.status() {
                Err(_) => { driver_io.text(2, "linking failed (cannot start linker)\n"); return BuildResult.failed(); },
                Ok(status) => { if (!status.success()) {
                    int code = driver_paths.exit_code(status); driver_io.text(2, "linking failed (exit {code})\n"); return BuildResult.failed();
                } }
            }
            }
            if (!options.keep_object) { var removed = fs.remove(object); }
            return BuildResult { ok: true, executable: executable, object: object, source_hash: source_hash };
        }
    }
}
