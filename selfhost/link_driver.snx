/// Stage-0 bridge to the Synx linker. Arguments remain separate through launch.
import link.linker;
import std.env;
import std.io;
import link.model;
import driver_io;
main() {
    var args = env.args(); if (args.len() != 5) { print("usage: synx-link <linux|windows|macos> <object> <output> <runtime>"); return 1; }
    var os_name = args.get(1).unwrap().as_str();
    int os = if (os_name == "windows") { 1 } else { if (os_name == "macos") { 2 } else { if (os_name == "linux") { 0 } else { -1 } } };
    match linker.file(args.get(2).unwrap().as_str(), args.get(3).unwrap().as_str(), args.get(4).unwrap().as_str(), os) {
        Ok(_) => return 0,
        Err(error) => { var description = model.description(error.code); driver_io.text(2, "built-in linker: {description} {error.symbol} (input {error.input}, record {error.record})\n"); return 1; }
    }
}
