/// Token records. Ported from compiler/include/synx/token.hpp.
/// Text retains decoded bytes.
import source.Span;
import bytes;

pub enum Kind {
    Eof,
    Error,
    Ident,
    IntLit,
    LongLit,
    FloatLit,
    DoubleLit,
    CharLit,
    StringLit,
    StringStart,
    StringText,
    InterpStart,
    InterpEnd,
    StringEnd,
    DocComment,
    KwAs,
    KwAsync,
    KwAwait,
    KwBreak,
    KwConst,
    KwContinue,
    KwDyn,
    KwElse,
    KwEnum,
    KwExtern,
    KwFalse,
    KwFn,
    KwFor,
    KwIf,
    KwImpl,
    KwImport,
    KwIn,
    KwLoop,
    KwMatch,
    KwOnce,
    KwPub,
    KwReturn,
    KwSelf,
    KwSelfType,
    KwStruct,
    KwTrait,
    KwTrue,
    KwUnsafe,
    KwVar,
    KwWhile,
    KwBool,
    KwByte,
    KwShort,
    KwInt,
    KwLong,
    KwUint,
    KwUlong,
    KwUsize,
    KwFloat,
    KwDouble,
    KwChar,
    KwVoid,
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,
    Comma,
    Semi,
    Colon,
    ColonColon,
    Dot,
    DotDot,
    DotDotEq,
    Arrow,
    FatArrow,
    Question,
    QuestionDot,
    QuestionQuestion,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Eq,
    EqEq,
    Bang,
    BangEq,
    Lt,
    Gt,
    LtEq,
    GtEq,
    AmpAmp,
    PipePipe,
    Amp,
    Pipe,
    Caret,
    Tilde,
    Shl,
    PlusEq,
    MinusEq,
    StarEq,
    SlashEq,
    PercentEq,
    AmpEq,
    PipeEq,
    CaretEq,
    ShlEq,
    ShrEq
}

pub uint index(Kind kind) {
    match kind {
        Kind.Eof => return 0,
        Kind.Error => return 1,
        Kind.Ident => return 2,
        Kind.IntLit => return 3,
        Kind.LongLit => return 4,
        Kind.FloatLit => return 5,
        Kind.DoubleLit => return 6,
        Kind.CharLit => return 7,
        Kind.StringLit => return 8,
        Kind.StringStart => return 9,
        Kind.StringText => return 10,
        Kind.InterpStart => return 11,
        Kind.InterpEnd => return 12,
        Kind.StringEnd => return 13,
        Kind.DocComment => return 14,
        Kind.KwAs => return 15,
        Kind.KwAsync => return 16,
        Kind.KwAwait => return 17,
        Kind.KwBreak => return 18,
        Kind.KwConst => return 19,
        Kind.KwContinue => return 20,
        Kind.KwDyn => return 21,
        Kind.KwElse => return 22,
        Kind.KwEnum => return 23,
        Kind.KwExtern => return 24,
        Kind.KwFalse => return 25,
        Kind.KwFn => return 26,
        Kind.KwFor => return 27,
        Kind.KwIf => return 28,
        Kind.KwImpl => return 29,
        Kind.KwImport => return 30,
        Kind.KwIn => return 31,
        Kind.KwLoop => return 32,
        Kind.KwMatch => return 33,
        Kind.KwOnce => return 34,
        Kind.KwPub => return 35,
        Kind.KwReturn => return 36,
        Kind.KwSelf => return 37,
        Kind.KwSelfType => return 38,
        Kind.KwStruct => return 39,
        Kind.KwTrait => return 40,
        Kind.KwTrue => return 41,
        Kind.KwUnsafe => return 42,
        Kind.KwVar => return 43,
        Kind.KwWhile => return 44,
        Kind.KwBool => return 45,
        Kind.KwByte => return 46,
        Kind.KwShort => return 47,
        Kind.KwInt => return 48,
        Kind.KwLong => return 49,
        Kind.KwUint => return 50,
        Kind.KwUlong => return 51,
        Kind.KwUsize => return 52,
        Kind.KwFloat => return 53,
        Kind.KwDouble => return 54,
        Kind.KwChar => return 55,
        Kind.KwVoid => return 56,
        Kind.LParen => return 57,
        Kind.RParen => return 58,
        Kind.LBracket => return 59,
        Kind.RBracket => return 60,
        Kind.LBrace => return 61,
        Kind.RBrace => return 62,
        Kind.Comma => return 63,
        Kind.Semi => return 64,
        Kind.Colon => return 65,
        Kind.ColonColon => return 66,
        Kind.Dot => return 67,
        Kind.DotDot => return 68,
        Kind.DotDotEq => return 69,
        Kind.Arrow => return 70,
        Kind.FatArrow => return 71,
        Kind.Question => return 72,
        Kind.QuestionDot => return 73,
        Kind.QuestionQuestion => return 74,
        Kind.Plus => return 75,
        Kind.Minus => return 76,
        Kind.Star => return 77,
        Kind.Slash => return 78,
        Kind.Percent => return 79,
        Kind.Eq => return 80,
        Kind.EqEq => return 81,
        Kind.Bang => return 82,
        Kind.BangEq => return 83,
        Kind.Lt => return 84,
        Kind.Gt => return 85,
        Kind.LtEq => return 86,
        Kind.GtEq => return 87,
        Kind.AmpAmp => return 88,
        Kind.PipePipe => return 89,
        Kind.Amp => return 90,
        Kind.Pipe => return 91,
        Kind.Caret => return 92,
        Kind.Tilde => return 93,
        Kind.Shl => return 94,
        Kind.PlusEq => return 95,
        Kind.MinusEq => return 96,
        Kind.StarEq => return 97,
        Kind.SlashEq => return 98,
        Kind.PercentEq => return 99,
        Kind.AmpEq => return 100,
        Kind.PipeEq => return 101,
        Kind.CaretEq => return 102,
        Kind.ShlEq => return 103,
        Kind.ShrEq => return 104,
    }
}
pub &const str name(Kind kind) {
    match kind {
        Kind.Eof => return "end of file",
        Kind.Error => return "invalid token",
        Kind.Ident => return "identifier",
        Kind.IntLit => return "integer literal",
        Kind.LongLit => return "long literal",
        Kind.FloatLit => return "float literal",
        Kind.DoubleLit => return "double literal",
        Kind.CharLit => return "char literal",
        Kind.StringLit => return "string literal",
        Kind.StringStart => return "string start",
        Kind.StringText => return "string text",
        Kind.InterpStart => return "interpolation start",
        Kind.InterpEnd => return "interpolation end",
        Kind.StringEnd => return "string end",
        Kind.DocComment => return "doc comment",
        Kind.KwAs => return "as",
        Kind.KwAsync => return "async",
        Kind.KwAwait => return "await",
        Kind.KwBreak => return "break",
        Kind.KwConst => return "const",
        Kind.KwContinue => return "continue",
        Kind.KwDyn => return "dyn",
        Kind.KwElse => return "else",
        Kind.KwEnum => return "enum",
        Kind.KwExtern => return "extern",
        Kind.KwFalse => return "false",
        Kind.KwFn => return "fn",
        Kind.KwFor => return "for",
        Kind.KwIf => return "if",
        Kind.KwImpl => return "impl",
        Kind.KwImport => return "import",
        Kind.KwIn => return "in",
        Kind.KwLoop => return "loop",
        Kind.KwMatch => return "match",
        Kind.KwOnce => return "once",
        Kind.KwPub => return "pub",
        Kind.KwReturn => return "return",
        Kind.KwSelf => return "self",
        Kind.KwSelfType => return "Self",
        Kind.KwStruct => return "struct",
        Kind.KwTrait => return "trait",
        Kind.KwTrue => return "true",
        Kind.KwUnsafe => return "unsafe",
        Kind.KwVar => return "var",
        Kind.KwWhile => return "while",
        Kind.KwBool => return "bool",
        Kind.KwByte => return "byte",
        Kind.KwShort => return "short",
        Kind.KwInt => return "int",
        Kind.KwLong => return "long",
        Kind.KwUint => return "uint",
        Kind.KwUlong => return "ulong",
        Kind.KwUsize => return "usize",
        Kind.KwFloat => return "float",
        Kind.KwDouble => return "double",
        Kind.KwChar => return "char",
        Kind.KwVoid => return "void",
        Kind.LParen => return "(",
        Kind.RParen => return ")",
        Kind.LBracket => return "[",
        Kind.RBracket => return "]",
        Kind.LBrace => return "{{",
        Kind.RBrace => return "}}",
        Kind.Comma => return ",",
        Kind.Semi => return ";",
        Kind.Colon => return ":",
        Kind.ColonColon => return "::",
        Kind.Dot => return ".",
        Kind.DotDot => return "..",
        Kind.DotDotEq => return "..=",
        Kind.Arrow => return "->",
        Kind.FatArrow => return "=>",
        Kind.Question => return "?",
        Kind.QuestionDot => return "?.",
        Kind.QuestionQuestion => return "??",
        Kind.Plus => return "+",
        Kind.Minus => return "-",
        Kind.Star => return "*",
        Kind.Slash => return "/",
        Kind.Percent => return "%",
        Kind.Eq => return "=",
        Kind.EqEq => return "==",
        Kind.Bang => return "!",
        Kind.BangEq => return "!=",
        Kind.Lt => return "<",
        Kind.Gt => return ">",
        Kind.LtEq => return "<=",
        Kind.GtEq => return ">=",
        Kind.AmpAmp => return "&&",
        Kind.PipePipe => return "||",
        Kind.Amp => return "&",
        Kind.Pipe => return "|",
        Kind.Caret => return "^",
        Kind.Tilde => return "~",
        Kind.Shl => return "<<",
        Kind.PlusEq => return "+=",
        Kind.MinusEq => return "-=",
        Kind.StarEq => return "*=",
        Kind.SlashEq => return "/=",
        Kind.PercentEq => return "%=",
        Kind.AmpEq => return "&=",
        Kind.PipeEq => return "|=",
        Kind.CaretEq => return "^=",
        Kind.ShlEq => return "<<=",
        Kind.ShrEq => return ">>=",
    }
}
pub bool is_keyword(Kind kind) { return index(kind) >= index(Kind.KwAs) && index(kind) <= index(Kind.KwVoid); }
pub bool is_primitive_type_keyword(Kind kind) { return index(kind) >= index(Kind.KwBool) && index(kind) <= index(Kind.KwVoid); }
pub Kind keyword(&const Vec<byte> word) {
    if (bytes.equals(word, "as")) { return Kind.KwAs; }
    if (bytes.equals(word, "async")) { return Kind.KwAsync; }
    if (bytes.equals(word, "await")) { return Kind.KwAwait; }
    if (bytes.equals(word, "break")) { return Kind.KwBreak; }
    if (bytes.equals(word, "const")) { return Kind.KwConst; }
    if (bytes.equals(word, "continue")) { return Kind.KwContinue; }
    if (bytes.equals(word, "dyn")) { return Kind.KwDyn; }
    if (bytes.equals(word, "else")) { return Kind.KwElse; }
    if (bytes.equals(word, "enum")) { return Kind.KwEnum; }
    if (bytes.equals(word, "extern")) { return Kind.KwExtern; }
    if (bytes.equals(word, "false")) { return Kind.KwFalse; }
    if (bytes.equals(word, "fn")) { return Kind.KwFn; }
    if (bytes.equals(word, "for")) { return Kind.KwFor; }
    if (bytes.equals(word, "if")) { return Kind.KwIf; }
    if (bytes.equals(word, "impl")) { return Kind.KwImpl; }
    if (bytes.equals(word, "import")) { return Kind.KwImport; }
    if (bytes.equals(word, "in")) { return Kind.KwIn; }
    if (bytes.equals(word, "loop")) { return Kind.KwLoop; }
    if (bytes.equals(word, "match")) { return Kind.KwMatch; }
    if (bytes.equals(word, "once")) { return Kind.KwOnce; }
    if (bytes.equals(word, "pub")) { return Kind.KwPub; }
    if (bytes.equals(word, "return")) { return Kind.KwReturn; }
    if (bytes.equals(word, "self")) { return Kind.KwSelf; }
    if (bytes.equals(word, "Self")) { return Kind.KwSelfType; }
    if (bytes.equals(word, "struct")) { return Kind.KwStruct; }
    if (bytes.equals(word, "trait")) { return Kind.KwTrait; }
    if (bytes.equals(word, "true")) { return Kind.KwTrue; }
    if (bytes.equals(word, "unsafe")) { return Kind.KwUnsafe; }
    if (bytes.equals(word, "var")) { return Kind.KwVar; }
    if (bytes.equals(word, "while")) { return Kind.KwWhile; }
    if (bytes.equals(word, "bool")) { return Kind.KwBool; }
    if (bytes.equals(word, "byte")) { return Kind.KwByte; }
    if (bytes.equals(word, "short")) { return Kind.KwShort; }
    if (bytes.equals(word, "int")) { return Kind.KwInt; }
    if (bytes.equals(word, "long")) { return Kind.KwLong; }
    if (bytes.equals(word, "uint")) { return Kind.KwUint; }
    if (bytes.equals(word, "ulong")) { return Kind.KwUlong; }
    if (bytes.equals(word, "usize")) { return Kind.KwUsize; }
    if (bytes.equals(word, "float")) { return Kind.KwFloat; }
    if (bytes.equals(word, "double")) { return Kind.KwDouble; }
    if (bytes.equals(word, "char")) { return Kind.KwChar; }
    if (bytes.equals(word, "void")) { return Kind.KwVoid; }
    return Kind.Ident;
}
pub struct Token {
    pub Kind kind;
    pub Span span;
    pub Vec<byte> text;
    pub ulong int_value;
    pub double float_value;
    pub Token new(Kind kind, Span span) {
        return Token { kind: kind, span: span, text: Vec.new(), int_value: 0, float_value: 0.0 };
    }
}

impl Eq for Kind { bool eq(&const self, &const Self other) { return index(*self) == index(*other); } }
