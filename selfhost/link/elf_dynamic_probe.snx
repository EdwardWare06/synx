/// Dynamic ELF fixtures exercise runtime startup and the zero-import path.
/// This probe emits bytes only; the host harness owns executable permissions.
import link.model.{Object, Section, Symbol, Binding, Definition, SectionKind, Failure, Code};
import link.imports;
import link.imports.Import;
import link.startup;
import link.elf;
import link.native_checks;
import std.env;
import std.fs;
import std.path.Path;
import std.utf8;

T expect<T>(Result<T, Failure> value) {
    return match value { Ok(item) => item, Err(_) => panic("dynamic ELF fixture failed") };
}
void reject(Result<Vec<byte>, Failure> value) {
    match value {
        Ok(_) => panic("dynamic ELF accepted an invalid import"),
        Err(error) => { match error.code { Invalid => {}, _ => panic("unexpected dynamic ELF import error") } }
    }
}
pub void run() {
    var args = env.args();
    if (args.len() != 2) { panic("usage: elf_dynamic_probe <output-directory>"); }
    var directory = Path.from(args.get(1).unwrap().as_str());
    // Runtime wrapper calls the ordinary generated-code entry and can retain
    // the separate thread callback. Entry returns 42; no worker is created.
    var program = Object.new("dynamic fixture", false);
    program.sections.push(Section.new(SectionKind.Text, 16, native_checks.octets("b82a000000c3c3")));
    program.symbols.push(Symbol.new("synx_entry", Binding.Global, Definition.Section(0, 0)));
    program.symbols.push(Symbol.new("synx_thread_entry", Binding.Global, Definition.Section(0, 6)));
    Vec<Object> inputs = Vec.new(); inputs.push(program); inputs.push(startup.make(0));
    var imported = expect(imports.collect(inputs, "libsynx_rt.so", 0));
    var bytes = expect(elf.write_dynamic(inputs, "__synx_start", imported));
    match fs.write(directory.join("dynamic.elf").as_str(), bytes) {
        Ok(_) => {}, Err(_) => panic("cannot write dynamic ELF fixture")
    }
    var empty_inputs = native_checks.fixture(false);
    Vec<Import> no_imports = Vec.new();
    var empty_bytes = expect(elf.write_dynamic(empty_inputs, "entry", no_imports));
    match fs.write(directory.join("dynamic-empty.elf").as_str(), empty_bytes) {
        Ok(_) => {}, Err(_) => panic("cannot write empty dynamic ELF fixture")
    }
    String nul_library = String.from("libbad.so"); nul_library.push((0 as byte) as char);
    Vec<Import> invalid_library = Vec.new();
    invalid_library.push(Import { name: utf8.encode("external"), library: nul_library });
    reject(elf.write_dynamic(empty_inputs, "entry", invalid_library));
    Vec<byte> nul_name = utf8.encode("external"); nul_name.push(0);
    Vec<Import> invalid_name = Vec.new();
    invalid_name.push(Import { name: nul_name, library: String.from("libbad.so") });
    reject(elf.write_dynamic(empty_inputs, "entry", invalid_name));
}
