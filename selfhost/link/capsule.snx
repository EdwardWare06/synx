/// Validate the selected runtime image and its callable exports before output.
/// Tables are bounded by their containing file. Symbol names remain owned.
import link.reader;
import link.model.{Failure, Code};
import link.model;
import link.imports.Import;
import std.collections.HashMap;
import std.utf8;
Result<ulong, Failure> word(&const Vec<byte> data, usize at, usize size) {
    return match reader.word(data, at, size, true) { Ok(value) => Ok(value), Err(_) => Err(model.fail(Code.Invalid, 0, at)) };
}
Result<bool, Failure> extent(&const Vec<byte> data, ulong at, ulong size) {
    if (at > data.len() as ulong || size > data.len() as ulong - at) { return Err(model.fail(Code.Invalid, 0, 0)); }
    return Ok(true);
}
Result<String, Failure> string(&const Vec<byte> data, usize at, usize end) {
    if (end > data.len() || at >= end) { return Err(model.fail(Code.Invalid, 0, at)); }
    usize stop = at; while (stop < end && *data.get(stop).unwrap() != 0) { stop += 1; }
    if (stop == end || stop - at > 4096) { return Err(model.fail(Code.Invalid, 0, at)); }
    var bytes = match reader.copy(data, at, stop - at) { Ok(value) => value, Err(_) => return Err(model.fail(Code.Invalid, 0, at)) };
    return match utf8.decode(bytes) { Some(value) => Ok(value), None => Err(model.fail(Code.Invalid, 0, at)) };
}
Result<usize, Failure> pe_offset(&const Vec<byte> data, usize sections, usize count, ulong rva, ulong size) {
    for (i in 0..count) {
        usize at = sections + i * 40;
        ulong start = word(data, at + 12, 4)?; ulong length = word(data, at + 16, 4)?;
        if (rva >= start && rva - start <= length && size <= length - (rva - start)) {
            ulong offset = word(data, at + 20, 4)? + rva - start;
            var valid = extent(data, offset, size)?; return Ok(offset as usize);
        }
    }
    return Err(model.fail(Code.Invalid, 0, rva as usize));
}
pub Result<HashMap<String, bool>, Failure> exports(&const Vec<byte> data, int os) {
    HashMap<String, bool> result = HashMap.new();
    if (os == 1) {
        if (word(data, 0, 2)? != 0x5a4d) { return Err(model.fail(Code.Invalid, 0, 0)); }
        usize pe = word(data, 60, 4)? as usize;
        if (word(data, pe, 4)? != 0x4550 || word(data, pe + 4, 2)? != 0x8664 || word(data, pe + 22, 2)? & 0x2000 == 0) { return Err(model.fail(Code.Unsupported, 0, pe)); }
        usize count = word(data, pe + 6, 2)? as usize; usize optional = pe + 24;
        usize optional_size = word(data, pe + 20, 2)? as usize;
        if (optional_size < 120 || word(data, optional, 2)? != 0x20b || word(data, optional + 108, 4)? == 0) { return Err(model.fail(Code.Invalid, 0, optional)); }
        usize sections = optional + optional_size; var valid = extent(data, sections as ulong, count as ulong * 40)?;
        ulong export_rva = word(data, optional + 112, 4)?; ulong export_size = word(data, optional + 116, 4)?;
        if (export_size < 40) { return Err(model.fail(Code.Invalid, 0, optional)); }
        usize table = pe_offset(data, sections, count, export_rva, export_size)?;
        usize functions = word(data, table + 20, 4)? as usize; usize names = word(data, table + 24, 4)? as usize;
        usize function_table = pe_offset(data, sections, count, word(data, table + 28, 4)?, functions as ulong * 4)?;
        usize name_table = pe_offset(data, sections, count, word(data, table + 32, 4)?, names as ulong * 4)?;
        usize ordinal_table = pe_offset(data, sections, count, word(data, table + 36, 4)?, names as ulong * 2)?;
        for (i in 0..names) {
            usize ordinal = word(data, ordinal_table + i * 2, 2)? as usize;
            if (ordinal >= functions) { return Err(model.fail(Code.Invalid, 0, ordinal_table)); }
            ulong address = word(data, function_table + ordinal * 4, 4)?;
            if (address == 0 || (address >= export_rva && address - export_rva < export_size)) { continue; }
            usize start = pe_offset(data, sections, count, word(data, name_table + i * 4, 4)?, 1)?;
            var name = string(data, start, data.len())?; result.insert(name, true);
        }
    } else if (os == 0) {
        if (word(data, 0, 4)? != 0x464c457f || word(data, 4, 2)? != 0x102 || word(data, 16, 2)? != 3 || word(data, 18, 2)? != 62 || word(data, 58, 2)? != 64) { return Err(model.fail(Code.Unsupported, 0, 0)); }
        ulong sections = word(data, 40, 8)?; usize count = word(data, 60, 2)? as usize;
        var valid = extent(data, sections, count as ulong * 64)?;
        for (i in 0..count) {
            usize at = sections as usize + i * 64; if (word(data, at + 4, 4)? != 11) { continue; }
            ulong start = word(data, at + 24, 8)?; ulong size = word(data, at + 32, 8)?;
            usize strings = word(data, at + 40, 4)? as usize;
            if (strings >= count || word(data, at + 56, 8)? != 24 || size % 24 != 0) { return Err(model.fail(Code.Invalid, 0, at)); }
            var table_valid = extent(data, start, size)?;
            usize str_header = sections as usize + strings * 64;
            ulong str_start = word(data, str_header + 24, 8)?; ulong str_size = word(data, str_header + 32, 8)?;
            var strings_valid = extent(data, str_start, str_size)?;
            for (j in 0..(size / 24) as usize) {
                usize symbol = start as usize + j * 24;
                ulong info = word(data, symbol + 4, 1)?; ulong visibility = word(data, symbol + 5, 1)? & 3;
                if (word(data, symbol + 6, 2)? == 0 || info >> 4 == 0 || (info & 15 != 2 && info & 15 != 10) || visibility == 1 || visibility == 2) { continue; }
                ulong offset = word(data, symbol, 4)?; if (offset >= str_size) { return Err(model.fail(Code.Invalid, 0, symbol)); }
                result.insert(string(data, (str_start + offset) as usize, (str_start + str_size) as usize)?, true);
            }
        }
    } else if (os == 2) {
        if (word(data, 0, 4)? != 0xfeedfacf || word(data, 4, 4)? != 0x1000007 || word(data, 12, 4)? != 6) { return Err(model.fail(Code.Unsupported, 0, 0)); }
        usize count = word(data, 16, 4)? as usize; usize size = word(data, 20, 4)? as usize;
        var valid = extent(data, 32, size as ulong)?; usize at = 32;
        for (i in 0..count) {
            usize length = word(data, at + 4, 4)? as usize;
            if (length < 8 || at > 32 + size || length > 32 + size - at) { return Err(model.fail(Code.Invalid, 0, at)); }
            if (word(data, at, 4)? == 2) {
                if (length < 24) { return Err(model.fail(Code.Invalid, 0, at)); }
                usize symbols = word(data, at + 8, 4)? as usize; usize n = word(data, at + 12, 4)? as usize;
                usize strings = word(data, at + 16, 4)? as usize; usize str_size = word(data, at + 20, 4)? as usize;
                var symbol_valid = extent(data, symbols as ulong, n as ulong * 16)?;
                var strings_valid = extent(data, strings as ulong, str_size as ulong)?;
                for (j in 0..n) {
                    usize symbol = symbols + j * 16; ulong kind = word(data, symbol + 4, 1)?;
                    if (kind & 0xe0 != 0 || kind & 0x11 != 1 || kind & 0xe != 0xe) { continue; }
                    usize offset = word(data, symbol, 4)? as usize;
                    if (offset >= str_size) { return Err(model.fail(Code.Invalid, 0, symbol)); }
                    result.insert(string(data, strings + offset, strings + str_size)?, true);
                }
            }
            at += length;
        }
    } else { return Err(model.fail(Code.Unsupported, 0, 0)); }
    return Ok(result);
}
pub Result<bool, Failure> validate(&const Vec<byte> data, &const Vec<Import> imports, int os) {
    var names = exports(data, os)?;
    for (i in 0..imports.len()) {
        var item = imports.get(i).unwrap();
        var name = match utf8.decode(item.name) { Some(value) => value, None => return Err(model.fail(Code.Invalid, 0, i)) };
        if (!name.starts_with("synx_rt_") && !name.starts_with("_synx_rt_")) { continue; }
        if (!names.contains_key(name)) { return Err(model.named(Code.Unresolved, 0, i, name)); }
    }
    return Ok(true);
}
