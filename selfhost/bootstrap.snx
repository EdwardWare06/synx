/// Bootstrap runner: C++ stage 0 -> Synx stage 1 -> stage 2 -> stage 3.
/// Retains every executable/object and compares complete object bytes.
/// SYNX_STD_PATH and SYNX_RUNTIME_LIB are inherited from the launch scripts.
import std.fs;
import std.env;
import std.path.{Path, Style, host_style};
import std.process.Command;
import bytes;

/// Windows canonical paths use an extended prefix. Convert that prefix before
/// lexical joins, because extended paths do not accept slash separators.
Result<String, fs.IoError> source_directory(&const str input) {
    var raw = fs.canonicalize(input)?;
    var normalized = Path.from(raw).normalize(); var value = String.from(normalized.as_str());
    match host_style() { Unix => return Ok(value), Windows => {} }
    if (value.starts_with("//?/UNC/")) {
        var tail = unsafe { str_from_raw((value.as_str().as_ptr() as usize + 8) as *const byte, value.len() - 8) };
        return Ok("//{tail}");
    }
    if (value.starts_with("//?/")) {
        return Ok(String.from(unsafe { str_from_raw((value.as_str().as_ptr() as usize + 4) as *const byte, value.len() - 4) }));
    }
    return Ok(value);
}
bool run(&const str program, &const Vec<String> args) {
    var command = Command.new(program); for (arg in args) { command.arg(arg); }
    match command.status() {
        Err(error) => { print("cannot start {program} (OS error {error.os_code})"); return false; },
        Ok(status) => { if (status.success()) { return true; }
            match status.code { Some(code) => print("{program} exited {code}"), None => {} }
            match status.signal { Some(signal) => print("{program} terminated by signal {signal}"), None => {} }
            return false;
        }
    }
}
bool equal_files(&const str a, &const str b) {
    var left = fs.read(a); var right = fs.read(b);
    match left {
        Err(_) => { print("cannot read bootstrap object {a}"); return false; },
        Ok(x) => { match right {
            Err(_) => { print("cannot read bootstrap object {b}"); return false; },
            Ok(y) => {
                usize n = if (x.len() < y.len()) { x.len() } else { y.len() };
                for (i in 0..n) { if (bytes.at(x, i) != bytes.at(y, i)) { print("object mismatch at byte {i}: {a} / {b}"); return false; } }
                if (x.len() != y.len()) { print("object size mismatch: {a} / {b}"); return false; }
                print("identical objects: {a} / {b} ({n} bytes)"); return true;
            }
        } }
    }
}
bool build(&const str compiler, &const str source, &const str output, &const Vec<String> flags, bool builtin) {
    Vec<String> args = Vec.new(); args.push(String.from("build")); args.push(String.from(source));
    args.push(String.from("-o")); args.push(String.from(output)); args.push(String.from("--keep-obj"));
    args.push(String.from(if (builtin) { "--linker=builtin" } else { "--linker=system" }));
    for (flag in flags) { args.push(String.from(flag)); } return run(compiler, args);
}
int main() {
    var args = env.args(); if (args.len() < 4) { print("usage: bootstrap <stage0> <source-root> <output-dir> [--release] [--no-regalloc]"); return 1; }
    String source_root = match source_directory(args.get(2).unwrap().as_str()) { Ok(path) => path, Err(_) => { print("cannot resolve source root"); return 1; } };
    String output_root = match fs.absolute(args.get(3).unwrap().as_str()) { Ok(path) => path, Err(_) => { print("cannot resolve output directory"); return 1; } };
    match fs.exists(output_root) { Ok(false) => { match fs.create_dir(output_root) { Ok(_) => {}, Err(_) => { print("cannot create {output_root}"); return 1; } } },
        Ok(true) => {}, Err(_) => { print("cannot inspect {output_root}"); return 1; } }
    var source = Path.from(source_root).join("selfhost/main.snx");
    var dir = Path.from(output_root);
    var suffix = match host_style() { Windows => ".exe", Unix => "" };
    var object_suffix = match host_style() { Windows => ".obj", Unix => ".o" };
    Vec<String> flags = Vec.new();
    for (i in 4..args.len()) {
        var flag = args.get(i).unwrap(); if (flag.is_empty()) { continue; }
        if (*flag != String.from("--release") && *flag != String.from("--no-regalloc")) { print("unknown bootstrap option: {flag}"); return 1; }
        flags.push(String.from(flag));
    }
    var stage1 = dir.join("synx-stage1{suffix}"); var stage2 = dir.join("synx-stage2{suffix}"); var stage3 = dir.join("synx-stage3{suffix}");
    print("Building stage 1 with stage 0"); if (!build(args.get(1).unwrap().as_str(), source.as_str(), stage1.as_str(), flags, false)) { return 1; }
    print("Building stage 2 with stage 1"); if (!build(stage1.as_str(), source.as_str(), stage2.as_str(), flags, true)) { return 1; }
    print("Building stage 3 with stage 2"); if (!build(stage2.as_str(), source.as_str(), stage3.as_str(), flags, true)) { return 1; }
    var object1 = "{stage1.as_str()}{object_suffix}"; var object2 = "{stage2.as_str()}{object_suffix}"; var object3 = "{stage3.as_str()}{object_suffix}";
    if (!equal_files(object1, object2) || !equal_files(object2, object3)) { return 1; }
    Vec<String> version = Vec.new(); version.push(String.from("version"));
    if (!run(stage1.as_str(), version) || !run(stage2.as_str(), version) || !run(stage3.as_str(), version)) { return 1; }
    var workbench_source = Path.from(source_root).join("examples/workbench/main.snx"); var workbench = dir.join("workbench{suffix}");
    if (!build(stage2.as_str(), workbench_source.as_str(), workbench.as_str(), flags, true)) { return 1; }
    Vec<String> empty = Vec.new(); if (!run(workbench.as_str(), empty)) { return 1; }
    String report = "stage0={args.get(1).unwrap()}\nsource={source.as_str()}\nstage1={stage1.as_str()}\nstage2={stage2.as_str()}\nstage3={stage3.as_str()}\nobjects_identical=true\nworkbench=true\n";
    for (flag in &const flags) { report.push_str("flag={flag}\n"); }
    var report_path = dir.join("bootstrap.txt");
    match fs.write_text(report_path.as_str(), report) { Ok(_) => {}, Err(_) => { print("cannot write bootstrap report"); return 1; } }
    print("Bootstrap objects match. Artifacts: {output_root}"); return 0;
}
