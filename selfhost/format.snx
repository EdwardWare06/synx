/// Syntax formatter. Owns layout records and output; borrows the source and
/// syntax tree only during a call. Comments and literal bytes remain exact.
/// Formatting requires valid UTF-8 and syntax. A second parse must produce
/// the same strict syntax record with positions removed before edits escape.
import ast;
import ast_dump;
import bytes;
import source.{SourceFile, Span};
import token.{Kind, Token};
import lexer;
import parser.Parser;
import diagnostics.DiagnosticSink;
import std.utf8;

const usize NONE = 4294967295;
struct Piece {
    Kind kind;
    Span span;
    int comment; // 0 token, 1 line comment, 2 block comment
    int role; // angles 1/2, prefix 3, closure pipes 4/5/8, joined shift 6, binary 7
    int form; // brace: 0 block, 1 record, 2 grouped import
    usize mate;
    usize width;
    int before;
}
Piece piece(Kind kind, uint start, uint end, uint file, int comment) {
    return Piece { kind: kind, span: Span { start: start, end: end, file: file },
        comment: comment, role: 0, form: 0, mate: NONE, width: 0, before: 0 };
}
pub bool equal(&const Vec<byte> a, &const Vec<byte> b) {
    if (a.len() != b.len()) { return false; }
    for (i in 0..a.len()) { if (bytes.at(a, i) != bytes.at(b, i)) { return false; } }
    return true;
}
/// Ordinary lexer spans delimit gaps. Only comments occupy non-whitespace
/// gaps; nested block comments are consumed as a single unchanged record.
void trivia(&Vec<Piece> out, &const SourceFile file, uint start, uint end) {
    uint p = start;
    while (p < end) {
        byte c = bytes.at(file.data(), p as usize);
        if (c != 47 || p + 1 >= end) { p += 1; continue; }
        byte n = bytes.at(file.data(), (p + 1) as usize); uint begin = p;
        if (n == 47) {
            // The lexer ends a line comment at LF. An interior CR is text.
            while (p < end && bytes.at(file.data(), p as usize) != 10) { p += 1; }
            uint finish = p;
            if (finish > begin && bytes.at(file.data(), (finish - 1) as usize) == 13) { finish -= 1; }
            out.push(piece(Kind.DocComment, begin, finish, file.id, 1));
        } else if (n == 42) {
            p += 2; int depth = 1;
            while (p < end && depth > 0) {
                byte a = bytes.at(file.data(), p as usize); byte b = bytes.at(file.data(), (p + 1) as usize);
                if (a == 47 && b == 42) { depth += 1; p += 2; }
                else if (a == 42 && b == 47) { depth -= 1; p += 2; }
                else { p += 1; }
            }
            out.push(piece(Kind.DocComment, begin, p, file.id, 2));
        } else { p += 1; }
    }
}
struct Plan {
    Vec<Piece> pieces;
    Plan new(&const SourceFile file, &const Vec<Token> tokens) {
        Vec<Piece> out = Vec.new(); uint end = 0; usize i = 0;
        while (i < tokens.len()) {
            var t = tokens.get(i).unwrap(); trivia(&out, file, end, t.span.start);
            if (t.kind == Kind.Eof) { break; }
            if (t.kind == Kind.DocComment) { trivia(&out, file, t.span.start, t.span.end); end = t.span.end; i += 1; continue; }
            uint stop = t.span.end;
            if (t.kind == Kind.StringStart) {
                int depth = 1;
                while (depth > 0 && i + 1 < tokens.len()) {
                    i += 1; var part = tokens.get(i).unwrap(); stop = part.span.end;
                    if (part.kind == Kind.StringStart) { depth += 1; }
                    if (part.kind == Kind.StringEnd) { depth -= 1; }
                }
            }
            out.push(piece(t.kind, t.span.start, stop, file.id, 0)); end = stop; i += 1;
        }
        return Plan { pieces: out };
    }
    usize at(&const self, uint start) {
        usize lo = 0; usize hi = self.pieces.len();
        while (lo < hi) { usize mid = lo + (hi - lo) / 2; if (self.pieces.get(mid).unwrap().span.start < start) { lo = mid + 1; } else { hi = mid; } }
        return lo;
    }
    void angles(&self, uint start, uint end) {
        usize i = self.at(start);
        while (i < self.pieces.len() && self.pieces.get(i).unwrap().span.start < end) {
            var p = self.pieces.get_mut(i).unwrap();
            if (p.comment == 0 && p.kind == Kind.Lt) { p.role = 1; }
            if (p.comment == 0 && p.kind == Kind.Gt) { p.role = 2; }
            i += 1;
        }
    }
    void generic(&self, uint start) {
        usize i = self.at(start);
        while (i < self.pieces.len() && self.pieces.get(i).unwrap().comment != 0) { i += 1; }
        if (i >= self.pieces.len() || self.pieces.get(i).unwrap().kind != Kind.Lt) { return; }
        int depth = 0;
        while (i < self.pieces.len()) {
            var p = self.pieces.get_mut(i).unwrap();
            if (p.comment == 0 && p.kind == Kind.Lt) { p.role = 1; depth += 1; }
            if (p.comment == 0 && p.kind == Kind.Gt) { p.role = 2; depth -= 1; if (depth == 0) { return; } }
            i += 1;
        }
    }
    void brace(&self, Span span, int form) {
        usize i = self.at(span.start);
        while (i < self.pieces.len() && self.pieces.get(i).unwrap().span.start < span.end) {
            if (self.pieces.get(i).unwrap().kind == Kind.LBrace && self.pieces.get(i).unwrap().comment == 0) { self.pieces.get_mut(i).unwrap().form = form; return; } i += 1;
        }
    }
    void prefix(&self, uint start) {
        usize i = self.at(start); if (i < self.pieces.len() && self.pieces.get(i).unwrap().span.start == start) { self.pieces.get_mut(i).unwrap().role = 3; }
    }
    void annotate(&self, &const ast.Ast tree) {
        for (t in &const tree.types) {
            match t.kind {
                Path => self.angles(t.path.span.end, t.span.end),
                Dyn => self.angles(t.bound.path.span.end, t.span.end),
                Ref | Ptr => self.prefix(t.span.start),
                _ => {}
            }
        }
        for (f in &const tree.functions) {
            if (!f.generics.is_empty()) { self.generic(f.name_span.end); }
            for (p in &const f.params) { match p.self_kind { Ref | ConstRef => self.prefix(p.span.start), _ => {} } }
        }
        for (item in &const tree.items) {
            if (match item.kind { Import => true, _ => false }) { self.brace(item.span, 2); }
            if (!item.generics.is_empty()) {
                uint end = item.span.end; usize i = self.at(item.span.start);
                while (i < self.pieces.len() && self.pieces.get(i).unwrap().span.start < end) {
                    var p = self.pieces.get(i).unwrap(); if (p.kind == Kind.Lt) { uint start = p.span.start; self.generic(start); break; } i += 1;
                }
            }
        }
        for (p in &const tree.patterns) { if (match p.kind { Struct => true, _ => false }) { self.brace(p.span, 1); } }
        for (x in &const tree.exprs) {
            match x.kind {
                StructLit => self.brace(x.span, 1),
                Unary | Ref => self.prefix(x.span.start),
                Name => { if (!x.type_args.is_empty()) { usize i = self.at(x.span.start); if (i < self.pieces.len()) { self.generic(self.pieces.get(i).unwrap().span.end); } } },
                Field => { if (!x.type_args.is_empty()) { self.generic(x.name_span.end); } },
                Closure => {
                    uint end = tree.expr(x.b).span.start; usize i = self.at(x.span.start); bool first = true;
                    while (i < self.pieces.len() && self.pieces.get(i).unwrap().span.start < end) {
                        var p = self.pieces.get_mut(i).unwrap();
                        if (p.comment == 0 && p.kind == Kind.PipePipe) { p.role = 8; break; }
                        if (p.comment == 0 && p.kind == Kind.Pipe) { p.role = if (first) { 4 } else { 5 }; if (!first) { break; } first = false; }
                        i += 1;
                    }
                    for (capture in &const x.captures) { if (match capture.mode { Move => false, _ => true }) { self.prefix(capture.span.start); } }
                },
                _ => {}
            }
        }
        // Binary ranges override type annotations in array-size expressions.
        for (x in &const tree.exprs) {
            if (match x.kind { Binary => false, _ => true }) { continue; }
            uint start = tree.expr(x.a).span.end; uint end = tree.expr(x.b).span.start; usize i = self.at(start); bool first = true;
            while (i < self.pieces.len() && self.pieces.get(i).unwrap().span.start < end) {
                var p = self.pieces.get_mut(i).unwrap();
                if (p.comment == 0) { p.role = if ((match x.binary_op { Shr => true, _ => false }) && !first) { 6 } else { 7 }; first = false; } i += 1;
            }
        }
        // Item separation is anchored before its documentation comments.
        bool previous_import = false;
        for (item in &const tree.items) {
            usize i = self.at(item.span.start);
            while (i > 0 && self.pieces.get(i - 1).unwrap().comment != 0) { i -= 1; }
            bool is_import = match item.kind { Import => true, _ => false };
            if (i < self.pieces.len()) { self.pieces.get_mut(i).unwrap().before = if (previous_import && is_import) { 1 } else { 2 }; }
            previous_import = is_import;
        }
        Vec<usize> stack = Vec.new();
        for (i in 0..self.pieces.len()) {
            var p = self.pieces.get(i).unwrap(); if (p.comment != 0) { continue; }
            if (opening(p)) { stack.push(i); }
            else if (closing(p) && !stack.is_empty()) {
                usize open = stack.pop().unwrap(); int form = self.pieces.get(open).unwrap().form;
                self.pieces.get_mut(open).unwrap().mate = i;
                var close = self.pieces.get_mut(i).unwrap(); close.mate = open; close.form = form;
            }
        }
        // Saturated flat widths keep layout decisions bounded for large files.
        usize i = self.pieces.len();
        while (i > 0) {
            i -= 1; var p = self.pieces.get(i).unwrap();
            if (!opening(p) || p.mate == NONE) { continue; }
            usize end = p.mate; usize width = 2; usize j = i + 1;
            while (j < end && width < 101) {
                var next = self.pieces.get(j).unwrap();
                if (next.comment == 1 || (next.kind == Kind.LBrace && next.form == 0 && next.mate > j + 1)) { width = 101; break; }
                if (opening(next) && next.mate != NONE) { width += next.width + 1; j = next.mate + 1; }
                else { width += next.span.length() as usize + 1; j += 1; }
            }
            self.pieces.get_mut(i).unwrap().width = width;
        }
    }
}
bool opening(&const Piece p) { return p.comment == 0 && (p.kind == Kind.LParen || p.kind == Kind.LBracket || p.kind == Kind.LBrace || p.role == 1 || p.role == 4); }
bool closing(&const Piece p) { return p.comment == 0 && (p.kind == Kind.RParen || p.kind == Kind.RBracket || p.kind == Kind.RBrace || p.role == 2 || p.role == 5); }
bool binary(&const Piece p) {
    if (p.role == 7) { return true; } if (p.role != 0) { return false; }
    match p.kind {
        Eq | Plus | Minus | Star | Slash | Percent | EqEq | BangEq | Lt | Gt | LtEq | GtEq |
        AmpAmp | PipePipe | Amp | Pipe | Caret | Shl | PlusEq | MinusEq | StarEq | SlashEq |
        PercentEq | AmpEq | PipeEq | CaretEq | ShlEq | ShrEq | Arrow | FatArrow | QuestionQuestion => return true,
        _ => return false
    }
}
bool control(Kind k) { return k == Kind.KwIf || k == Kind.KwWhile || k == Kind.KwFor || k == Kind.KwMatch; }
bool space(&const Piece a, &const Piece b) {
    if (a.comment != 0 || b.comment != 0) { return true; }
    // Separate a postfix try from tokens that would become ?. or ??.
    if (a.kind == Kind.Question && (b.kind == Kind.Dot || b.kind == Kind.Question || b.kind == Kind.QuestionDot)) { return true; }
    if (b.role == 6) { return false; }
    if (b.kind == Kind.Comma || b.kind == Kind.Semi || b.kind == Kind.Colon || b.kind == Kind.RParen || b.kind == Kind.RBracket || b.role == 2 || b.role == 5) { return false; }
    if (a.kind == Kind.Dot || b.kind == Kind.Dot || a.kind == Kind.QuestionDot || b.kind == Kind.QuestionDot || a.kind == Kind.DotDot || b.kind == Kind.DotDot || a.kind == Kind.DotDotEq || b.kind == Kind.DotDotEq) { return false; }
    if (b.kind == Kind.Question || b.role == 1 || a.role == 1 || a.role == 4) { return false; }
    if (a.kind == Kind.LParen || a.kind == Kind.LBracket) { return false; }
    if (a.role == 3) { return a.kind == Kind.Amp && b.kind == Kind.Amp; }
    if (b.kind == Kind.LParen) { return control(a.kind) || binary(a) || a.kind == Kind.Comma || a.kind == Kind.Colon || a.kind == Kind.KwReturn || a.role == 5 || a.role == 8; }
    if (b.kind == Kind.LBracket) { return binary(a) || a.kind == Kind.Comma || a.kind == Kind.Colon || a.kind == Kind.KwReturn || a.kind == Kind.KwConst || a.kind == Kind.KwOnce; }
    if (a.kind == Kind.LBrace && a.form == 2) { return false; }
    if (b.kind == Kind.RBrace && b.form == 2) { return false; }
    if (b.kind == Kind.RBrace && a.kind == Kind.LBrace) { return false; }
    return true;
}
struct Frame { usize open; bool broken; bool block; }
struct Layout {
    Vec<byte> out;
    Vec<Frame> stack;
    usize indent;
    usize column;
    int pending;
    int next_eol;
    bool crlf;
    Layout new(&const SourceFile file) {
        bool crlf = false; for (i in 0..file.data().len()) { if (bytes.at(file.data(), i) == 10) { crlf = i > 0 && bytes.at(file.data(), i - 1) == 13; break; } }
        return Layout { out: Vec.new(), stack: Vec.new(), indent: 0, column: 0, pending: 0, next_eol: -1, crlf: crlf };
    }
    void line(&self, int count) {
        if (self.out.is_empty()) { return; }
        int have = 0; usize i = self.out.len();
        while (i > 0) { byte c = bytes.at(self.out, i - 1); if (c == 10) { have += 1; } else if (c != 13) { break; } i -= 1; }
        while (have < count) {
            bool cr = if (self.next_eol >= 0) { self.next_eol == 1 } else { self.crlf }; self.next_eol = -1;
            if (cr) { self.out.push(13); } self.out.push(10); have += 1;
        }
        self.column = 0;
    }
    void raw(&self, &const SourceFile file, Span span) {
        if (self.column == 0) { for (i in 0..(self.indent * 4)) { self.out.push(32); } self.column = self.indent * 4; }
        for (i in (span.start as usize)..(span.end as usize)) { byte c = bytes.at(file.data(), i); self.out.push(c); if (c == 10) { self.column = 0; } else { self.column += 1; } }
    }
    void emit(&self, &const SourceFile file, &const Plan plan) {
        for (i in 0..plan.pieces.len()) {
            var p = plan.pieces.get(i).unwrap();
            bool trailing = p.comment != 0 && i > 0 && file.line_col(plan.pieces.get(i - 1).unwrap().span.end).line == file.line_col(p.span.start).line;
            if (p.before > self.pending && !trailing) { self.pending = p.before; }
            if (i > 0) {
                var prev = plan.pieces.get(i - 1).unwrap();
                bool attach = p.kind == Kind.KwElse || p.kind == Kind.Comma || p.kind == Kind.Semi || p.kind == Kind.RParen || p.kind == Kind.RBracket || p.kind == Kind.Dot || p.kind == Kind.QuestionDot || p.kind == Kind.Question || p.kind == Kind.KwAs || binary(p);
                if (prev.kind == Kind.RBrace && prev.comment == 0 && attach) { self.pending = 0; }
                if (!attach && !opening(prev) && !closing(p) && file.line_col(p.span.start).line > file.line_col(prev.span.end).line + 1 && self.pending < 2) { self.pending = 2; }
                if (p.comment != 0 && !trailing) {
                    uint lines = file.line_col(p.span.start).line - file.line_col(prev.span.end).line;
                    if (lines > 0 && self.pending < 1) { self.pending = 1; }
                    if (lines > 1 && self.pending < 2) { self.pending = 2; }
                }
            }
            bool close = closing(p); bool broken_close = false;
            if (close && !self.stack.is_empty()) {
                var frame = self.stack.pop().unwrap(); broken_close = frame.broken;
                if (frame.broken) { self.indent -= 1; self.pending = 1; }
            }
            if (self.pending > 0 && !trailing) { self.line(self.pending); self.pending = 0; }
            if (self.column > 0 && i > 0 && !broken_close && space(plan.pieces.get(i - 1).unwrap(), p)) { self.out.push(32); self.column += 1; }
            self.raw(file, p.span);
            if (p.comment != 0) {
                // A doc comment's CR byte belongs to its decoded text. Keep
                // each line comment's own ending even in a mixed-ending file.
                if (p.comment == 1) { self.next_eol = if (bytes.at(file.data(), p.span.end as usize) == 13) { 1 } else { 0 }; }
                if (p.comment == 1 || !trailing) { self.pending = 1; }
                continue;
            }
            if (opening(p)) {
                bool block = p.kind == Kind.LBrace && p.form == 0;
                bool broken = p.mate != NONE && p.mate != i + 1 && (block || self.column + p.width > 100);
                self.stack.push(Frame { open: i, broken: broken, block: block });
                if (broken) { self.indent += 1; self.pending = 1; }
            }
            if (p.kind == Kind.Semi) {
                bool list = !self.stack.is_empty() && plan.pieces.get(self.stack.get(self.stack.len() - 1).unwrap().open).unwrap().kind == Kind.LBracket;
                if (!list) { self.pending = 1; }
            }
            if (p.kind == Kind.Comma && !self.stack.is_empty() && self.stack.get(self.stack.len() - 1).unwrap().broken) { self.pending = 1; }
            if (p.kind == Kind.RBrace && p.form == 0) { self.pending = 1; }
        }
        self.line(1);
    }
}
pub struct Output { pub bool ok; pub Vec<byte> data; pub DiagnosticSink sink; }
pub Output file(&const SourceFile input) {
    var sink = DiagnosticSink.new();
    if (utf8.decode(input.data()).is_none()) {
        sink.error(Span { start: 0, end: 0, file: input.id }, "formatter input is not UTF-8", "");
        return Output { ok: false, data: Vec.new(), sink: sink };
    }
    var tokens = lexer.tokenize(input, &sink);
    var plan = Plan.new(input, tokens);
    var parser = Parser.new(input, tokens, sink); parser.parse_module();
    if (parser.sink.has_errors()) { return Output { ok: false, data: Vec.new(), sink: parser.sink }; }
    plan.annotate(parser.ast); var layout = Layout.new(input); layout.emit(input, plan); var output = layout.out;
    var formatted = SourceFile.new(String.from(input.path()), bytes.copy(output, 0, output.len()), input.id);
    var check_sink = DiagnosticSink.new(); var check_tokens = lexer.tokenize(formatted, &check_sink);
    var checked = Parser.new(formatted, check_tokens, check_sink); checked.parse_module();
    bool same = !checked.sink.has_errors() && equal(ast_dump.canonical_module(parser.ast), ast_dump.canonical_module(checked.ast));
    if (!same) {
        parser.sink.error(Span { start: 0, end: 0, file: input.id }, "formatter could not preserve syntax; source was left unchanged", "");
        return Output { ok: false, data: Vec.new(), sink: parser.sink };
    }
    return Output { ok: true, data: output, sink: parser.sink };
}
