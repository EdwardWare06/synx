int fib(int n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

main() {
    int sum = 0;
    for (i in 0..10) { sum += i; }
    int k = 0;
    while (k < 3) { k += 1; }
    loop { if (k >= 6) { break; } k += 1; }
    var sign = if (sum > 40) { 1 } else { -1 };
    print("{sum} {k} {sign} {fib(10)}");
    int[3] a = [10, 20, 30];
    int total = 0;
    for (x in a) { total += x; }
    print("{total} {a[1]}");
}
