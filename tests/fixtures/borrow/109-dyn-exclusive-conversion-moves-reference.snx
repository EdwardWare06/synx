// fixture: dyn exclusive conversion moves reference
// stage: full
// expect: error use of moved value
trait Read { int read(&const self); &const int view(&const self); } struct S { int n; } impl Read for S { int read(&const self) { return self.n; } &const int view(&const self) { return &const self.n; } } main() { var x = S { n: 1 }; var r = &x; &dyn Read d = r; r.n = 2; int n = d.read(); }
