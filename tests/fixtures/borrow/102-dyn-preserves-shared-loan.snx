// fixture: dyn preserves shared loan
// stage: full
// expect: error while it is borrowed
trait Read { int read(&const self); &const int view(&const self); } struct S { int n; } impl Read for S { int read(&const self) { return self.n; } &const int view(&const self) { return &const self.n; } } main() { var x = S { n: 1 }; &const dyn Read r = x; x.n = 2; int n = r.read(); }
