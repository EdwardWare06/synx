// fixture: dyn conversions
// stage: check
// expect: ok
trait Shape { int area(&const self); void grow(&self, int n); } struct Sq { int side; } impl Shape for Sq { int area(&const self) { return self.side * self.side; } void grow(&self, int n) { self.side += n; } } read(&const dyn Shape s) { int n = s.area(); } write(&dyn Shape s) { s.grow(2); } main() { var s = Sq { side: 2 }; read(s); read(&const s); write(&s); }
