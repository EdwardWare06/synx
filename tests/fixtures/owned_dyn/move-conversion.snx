// fixture: move-conversion
// stage: borrow
// expect: error SNX0501
trait Read { int read(&const self); }
struct Number { int value; }
impl Read for Number { int read(&const self) { return self.value; } }
main() { var x = Box.new(Number { value: 3 }); Box<dyn Read> y = x; print("{x.as_ref().value}"); }
