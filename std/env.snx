import std.utf8;
import std.fs.{IoError, ErrorKind};
extern "C" {
    int synx_rt_env_read(*const byte name, usize length, *byte buffer, &usize count);
    int synx_rt_exe_path(*byte buffer, usize capacity, &usize count);
    usize synx_rt_arg_count();
    *const byte synx_rt_arg_data(usize i);
    usize synx_rt_arg_len(usize i);
}
/// Returns owned arguments, including the executable name at index zero.
pub Vec<String> args() {
    Vec<String> values = Vec.new();
    usize count = unsafe { synx_rt_arg_count() };
    for (i in 0..count) {
        var text = unsafe { str_from_raw(synx_rt_arg_data(i), synx_rt_arg_len(i)) };
        var bytes = utf8.encode(text);
        match utf8.decode(bytes) {
            Some(value) => values.push(value),
            None => panic("command line argument is not valid UTF-8"),
        }
    }
    return values;
}

/// Read a variable without changing the process environment. A missing name is
/// Ok(None); an empty value is Ok(Some(empty)). Invalid UTF-8 is an error.
pub Result<String?, IoError> get(&const str name) {
    usize capacity = 256;
    while (true) {
        Vec<byte> bytes = Vec.new();
        for (i in 0..capacity) { bytes.push(0); }
        usize count = capacity;
        int code = unsafe { synx_rt_env_read(name.as_ptr(), name.len(), bytes.as_mut_ptr(), &count) };
        if (code == -2) { return Ok(None); }
        if (code == -1) {
            if (count <= capacity) { return Err(IoError { kind: ErrorKind.Other, os_code: 0 }); }
            capacity = count;
        } else {
            if (code != 0) { return Err(IoError.from_os(code)); }
            while (bytes.len() > count) { var unused = bytes.pop(); }
            match utf8.decode(bytes) {
                Some(text) => return Ok(Some(text)),
                None => return Err(IoError { kind: ErrorKind.InvalidUtf8, os_code: 0 }),
            }
        }
    }
    panic("unreachable environment read loop");
}

/// Return the absolute path of this executable. Symbolic links are resolved on
/// macOS and Linux. Windows returns the path used to load the executable.
pub Result<String, IoError> exe_path() {
    usize capacity = 256;
    while (true) {
        Vec<byte> bytes = Vec.new();
        for (i in 0..capacity) { bytes.push(0); }
        usize count = 0;
        int code = unsafe { synx_rt_exe_path(bytes.as_mut_ptr(), capacity, &count) };
        if (code == -1) {
            if (count <= capacity) { return Err(IoError { kind: ErrorKind.Other, os_code: 0 }); }
            capacity = count;
        } else {
            if (code != 0) { return Err(IoError.from_os(code)); }
            while (bytes.len() > count) { var unused = bytes.pop(); }
            match utf8.decode(bytes) {
                Some(text) => return Ok(text),
                None => return Err(IoError { kind: ErrorKind.InvalidUtf8, os_code: 0 }),
            }
        }
    }
    panic("unreachable executable path loop");
}
